# Add to the plugin server.env; install cloudflared 2025.4.0+ first.
# Create a dedicated tunnel and published hostname in the Cloudflare dashboard.
# Route the hostname to http://127.0.0.1:7681 (or your HERDR_SERVE_PORT).
HERDR_SERVE_CLOUDFLARE_ORIGIN=https://herdr.example.com
HERDR_SERVE_CLOUDFLARE_TOKEN_FILE=/home/you/.config/herdr/plugins/config/herdr.serve/cloudflare-token
# HERDR_SERVE_CLOUDFLARED_BINARY=/usr/local/bin/cloudflared
# Store only the tunnel token in the file above and chmod 600 it.
# Configure Cloudflare Access separately if you want an account whitelist.
